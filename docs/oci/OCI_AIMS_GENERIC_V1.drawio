        <mxCell id="scope1" value="Theo bố cục và các lớp của Oracle Generic v1. Phạm vi lab: shared security/network + OE01/Production.&lt;br&gt;Các khối mờ là mở rộng dự kiến; sơ đồ không khẳng định chúng đã được triển khai." vertex="1" parent="aims-overlay-2" style="html=1;whiteSpace=wrap;rounded=0;fontFamily=DejaVu Sans;fontSize=12;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#80999F;fillColor=#f4f2ef;strokeColor=none;fontSize=14;">
