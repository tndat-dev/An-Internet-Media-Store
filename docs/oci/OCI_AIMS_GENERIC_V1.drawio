          <mxGeometry as="geometry" x="1210" y="670" width="250" height="157" />
        </mxCell>
        <mxCell id="notes2" value="Đây là network ownership view: VCN/subnet ở cmp-oe01-common-network; OKE, nodes, volumes và Private LB ở cmp-oe01-prod.&lt;br&gt;Hai subnet API/Bastion được tách rõ trên trang 03; không coi chúng là một subnet.&lt;br&gt;Hub B thay bố trí firewall tổng quát trong mẫu. Không dựng thêm firewall OE, FastConnect, môi trường thử nghiệm hoặc cloud khác trong baseline lab." vertex="1" parent="aims-overlay-4" style="html=1;whiteSpace=wrap;rounded=0;fontFamily=DejaVu Sans;fontSize=12;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#80999F;fillColor=#f4f2ef;strokeColor=none;fontSize=13;">
