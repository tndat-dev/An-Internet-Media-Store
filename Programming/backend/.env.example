DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,thee-hatred-valley.ngrok-free.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# VietQR Integration
# Environment: dev | prod
VIETQR_ENV=dev

# Outbound VietQR credentials (AIMS → VietQR)
VIETQR_BASE_URL=https://dev.vietqr.org
VIETQR_USERNAME=customer-itss-user88888
VIETQR_PASSWORD=

# Bank info for QR generation
VIETQR_BANK_CODE=MB
VIETQR_BANK_ACCOUNT=0859246671
VIETQR_USER_BANK_NAME=Chu Tuan Linh

# Inbound VietQR credentials (VietQR → AIMS, for callbacks)
VIETQR_CALLBACK_USERNAME=customer-itss-user888888
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_TOKEN_TTL_SECONDS=300

# Request timeout
VIETQR_REQUEST_TIMEOUT=300

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@aims.local
# Use the Supabase Session pooler URI from Project Dashboard > Connect.
# Direct db.<project-ref>.supabase.co URLs usually require IPv6 or the IPv4 add-on.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_SANDBOX=true
PAYPAL_CURRENCY=USD
PAYPAL_VND_PER_USD=25000
