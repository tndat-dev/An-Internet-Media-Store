#include <tunables/global>

profile aims-restricted flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  capability chown,
  capability dac_override,
  capability fowner,
  capability setgid,
  capability setuid,

  deny capability sys_admin,
  deny capability sys_module,
  deny capability sys_ptrace,
  deny mount,
  deny ptrace,
  deny /proc/sys/** wklx,
  deny /sys/** wklx,
  deny /etc/kubernetes/** rwklx,
  deny /var/run/docker.sock rwklx,
  deny /run/containerd/containerd.sock rwklx,

  /usr/local/bin/python* ixr,
  /usr/local/bin/gunicorn ixr,
  /usr/** rix,
  /lib/** rix,
  /lib64/** rix,
  /app/ r,
  /app/** rwix,
  /app/** w,
  /tmp/** rw,
  /dev/null rw,
  /dev/urandom r,
  /etc/** r,
  /proc/** r,
}
