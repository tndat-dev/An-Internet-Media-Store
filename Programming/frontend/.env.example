# Same-origin path used by the Kubernetes Gateway. Override with a full URL
# only when running the frontend and API on separate origins in development.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
NEXT_PUBLIC_PAYPAL_CURRENCY=USD
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
